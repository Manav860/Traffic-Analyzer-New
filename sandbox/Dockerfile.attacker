FROM debian:bullseye-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    hydra \
    hping3 \
    curl \
    iputils-ping \
    net-tools \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY run_kill_chain.sh /workspace/run_kill_chain.sh
RUN chmod +x /workspace/run_kill_chain.sh

CMD ["/workspace/run_kill_chain.sh"]
